# Copy to .env and fill in.

# Where the contact form POSTs. Without it the form shows its phone/e-mail
# fallback instead of accepting submissions.
#
#   Netlify Forms   /  (plus data-netlify on the form)
#   Formspree       https://formspree.io/f/xxxxxxxx
#   Cloudflare      https://<worker>.workers.dev/kontakt
PUBLIC_FORM_ENDPOINT=
