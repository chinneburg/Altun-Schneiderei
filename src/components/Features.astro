---
const features = [
  {
    icon: '✂️',
    title: 'Änderungsschneiderei',
    text: 'Professionelle Anpassung von Damen- und Herrenbekleidung nach&nbsp;Maß.',
  },
  {
    icon: '👖',
    title: 'Hosen & Jeans',
    text: 'Fachgerechtes Kürzen, Engermachen oder Reparieren Ihrer Lieblingshosen.',
  },
  {
    icon: '🧥',
    title: 'Sakkos & Hemden',
    text: 'Perfekter Sitz durch Anpassungen an Ärmeln, Schultern und&nbsp;Taille.',
  },
  {
    icon: '👞',
    title: 'Schuhreparaturen',
    text: 'Auch Reparaturen an Schuhen und Sneakern führen wir für Sie durch.',
  },
  {
    icon: '⚡',
    title: 'Eilaufträge',
    text: 'Schnelle und zuverlässige Erledigung Ihrer Eilaufträge bei&nbsp;Bedarf.',
  },
  {
    icon: '🤝',
    title: 'Persönliche Beratung',
    text: 'Faire Preise, transparente Beratung und höchste handwerkliche Qualität.',
  },
];
---

<section id="leistungen" class="alt">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Unsere Leistungen</span>
      <h2>Handwerkliche Perfektion für Sie</h2>
      <p class="section-lead">
        Wir bieten Ihnen ein breites Spektrum an Schneider- und Reparaturarbeiten an.
      </p>
    </div>

    <div class="features">
      {
        features.map((feature) => (
          <div class="feature">
            <span class="feature-icon">{feature.icon}</span>
            <h3>{feature.title}</h3>
            <p set:html={feature.text} />
          </div>
        ))
      }
    </div>
  </div>
</section>
