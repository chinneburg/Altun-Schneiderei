---
const features = [
  {
    icon: '01 — Design',
    title: 'Individuelles Design',
    text: 'Modern und zu Ihrem Betrieb passend. Mit Ihren Farben, Fotos und&nbsp;Texten.',
  },
  {
    icon: '02 — Mobil',
    title: 'Perfekt am Handy',
    text: '70% Ihrer Besucher kommen vom Smartphone. Ihre Seite funktioniert&nbsp;überall.',
  },
  {
    icon: '03 — Sicherheit',
    title: 'Betrieb & DSGVO',
    text: 'Sicherer Betrieb in Deutschland, SSL und Rechtssicherheit – alles&nbsp;erledigt.',
  },
  {
    icon: '04 — Wartung',
    title: 'Wartung & Updates',
    text: 'Wir halten alles aktuell und sicher. Ihre Änderungswünsche sind&nbsp;inklusive.',
  },
  {
    icon: '05 — Sichtbarkeit',
    title: 'Bei Google gefunden',
    text: 'Saubere Technik und lokale Optimierung, damit Kunden Sie&nbsp;finden.',
  },
  {
    icon: '06 — Betreuung',
    title: 'Fester Ansprechpartner',
    text: 'Kein Ticketsystem, keine Warteschleife. Ein Mensch, der Sie&nbsp;kennt.',
  },
];
---

<section class="alt">
  <div class="container">
    <div id="leistungen" class="section-header">
      <span class="section-tag">Alles inklusive</span>
      <h2>Ein Preis. Rundum sorglos.</h2>
      <p class="section-lead">
        Design, sicherer Betrieb, Wartung, Support – alles ist in Ihrem Abo&nbsp;enthalten.
      </p>
    </div>

    <div class="features">
      {
        features.map((feature) => (
          <div class="feature">
            <span class="feature-icon">{feature.icon}</span>
            <h3>{feature.title}</h3>
            <p set:html={feature.text} />
          </div>
        ))
      }
    </div>
  </div>
</section>
