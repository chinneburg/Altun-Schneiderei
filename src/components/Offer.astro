---
import ContactForm from './ContactForm.astro';
---

<section id="kontakt">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Angebot & Kontakt</span>
      <h2>Rechnet sich von selbst</h2>
      <p class="section-lead">
        Unser Service rechnet sich nach kurzer Zeit von selbst – durch mehr Webseiten-Besucher und mehr
        Kunden. Probieren Sie es aus!
      </p>
    </div>

    <div class="offer-grid">
      <div class="offer-intro">
        <p class="offer-claim">
          Kein Risiko.<br />
          Sie sagen uns, was Sie vorhaben – wir machen Ihnen ein passendes Angebot.
        </p>

        <ul class="offer-points">
          <li>Antwort innerhalb von 24 Stunden</li>
        </ul>
      </div>

      <ContactForm />
    </div>
  </div>
</section>
