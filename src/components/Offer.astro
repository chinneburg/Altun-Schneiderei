---
import ContactForm from './ContactForm.astro';
---

<section id="pakete">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Angebot</span>
      <h2>Rechnet sich von selbst</h2>
      <p class="section-lead">
        Unser Service rechnet sich nach kurzer Zeit von selbst – durch mehr Traffic und mehr
        Kunden. Probieren Sie es aus! Angebot auf Anfrage.
      </p>
    </div>

    <div class="offer-grid">
      <div class="offer-intro">
        <p class="offer-claim">
          Kein Risiko, keine Einrichtungsgebühr. Sie sagen uns, was Sie vorhaben – wir machen
          Ihnen ein passendes Angebot.
        </p>
        <ul class="offer-points">
          <li>Keine Einrichtungsgebühr</li>
          <li>Antwort innerhalb von 24 Stunden</li>
        </ul>
      </div>

      <ContactForm />
    </div>
  </div>
</section>
