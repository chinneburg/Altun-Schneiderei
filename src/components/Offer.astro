---
import ContactForm from './ContactForm.astro';
---

<section id="kontakt">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Kontakt & Anfahrt</span>
      <h2>Wir freuen uns auf Ihren Besuch</h2>
      <p class="section-lead">
        Kommen Sie direkt vorbei oder rufen Sie uns an.
      </p>
    </div>

    <div class="offer-grid">
      <div class="offer-intro">
        <p class="offer-claim">
          Öffnungszeiten:<br />
          Montag – Freitag: 09:00 – 18:30 Uhr<br />
          Samstag: 09:00 – 14:00 Uhr
        </p>

        <ul class="offer-points">
          <li>Telefon: 0211 46841229</li>
          <li>Belsenstraße 25, 40545 Düsseldorf</li>
        </ul>
      </div>

      <ContactForm />
    </div>
  </div>
</section>
