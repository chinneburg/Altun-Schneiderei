---
import { nav } from '../site';
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo.jpg';
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="header-inner">
    <nav class="nav-left">
      <a href="/#leistungen" class="nav-link text-uppercase">Leistungen</a>
    </nav>
    
    <a class="logo" href="/">
      <Image src={logoImage} alt="Altun Logo" class="logo-img" />
    </a>

    <nav class="nav-right">
      <a href="/#kontakt" class="nav-link text-uppercase">Kontakt</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    background: var(--color-white);
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 70px;
    padding: 0 2rem;
  }

  .nav-left {
    display: flex;
    justify-content: flex-start;
  }

  .nav-right {
    display: flex;
    justify-content: flex-end;
  }

  .nav-link {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-black);
    transition: opacity 0.2s;
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-img {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    .header-inner {
      padding: 0 1rem;
    }
  }
</style>
