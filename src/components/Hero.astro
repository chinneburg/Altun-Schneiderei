---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
---

<section class="hero">
  <div class="image-hero">
    <!-- TODO: Bild 'hero.jpg' durch ein neutraleres Motiv (z. B. Büro/Beratungssituation) ersetzen, das auch Dienstleister anspricht -->
    <Image
      src={heroImage}
      alt="Modernes und helles Büro, stellvertretend für lokale Dienstleister, Steuerberater und Immobilienmakler"
      widths={[640, 960, 1280, 1920, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-tag">Ich sehe Neues</span>
      <h1>Moderne Webseite für Ihr lokales Geschäft</h1>
      <p class="hero-lead">
        nyveo macht Ihr Unternehmen online sichtbar – mit modernem Design, sicherem Betrieb der Seite und
        persönlichem Support. Alles aus einer Hand, zum festen Monatspreis. Fertig in unter 3 Wochen.
      </p>
    </div>
  </div>
</section>
