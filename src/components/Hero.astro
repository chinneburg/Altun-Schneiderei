---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
---

<section class="hero">
  <div class="image-hero">
    <Image
      src={heroImage}
      alt="Inhaber einer Motorenwerkstatt steht zwischen Werkbank und Regalen mit Ersatzteilen"
      widths={[640, 960, 1280, 1920, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-tag">Ich sehe Neues</span>
      <h1>Moderne Webseite für Ihr lokales Geschäft</h1>
      <p class="hero-lead">
        nyveo macht Ihr Unternehmen online sichtbar – mit modernem Design, sicherem Hosting und
        persönlichem Support. Alles aus einer Hand, zum festen Monatspreis. Fertig in 2–3 Wochen.
      </p>
      <div class="hero-cta-group">
        <a href="/#kontakt" class="btn primary">Kostenlos beraten lassen</a>
        <a href="/#pakete" class="btn secondary">Angebot anfragen</a>
      </div>
      <p class="hero-note">✓ Keine versteckten Kosten · Ihr Ansprechpartner</p>
    </div>
  </div>
</section>
