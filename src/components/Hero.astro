---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
---

<section class="hero">
  <div class="image-hero">
    <!-- TODO: Bild 'hero.jpg' durch ein neutraleres Motiv (z. B. Büro/Beratungssituation) ersetzen, das auch Dienstleister anspricht -->
    <Image
      src={heroImage}
      alt="Modernes und helles Büro, stellvertretend für lokale Dienstleister, Steuerberater und Immobilienmakler"
      widths={[640, 960, 1280, 1920, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-tag">Änderungsschneiderei Altun</span>
      <h1>Maßgeschneiderte Qualität für Ihre Kleidung</h1>
      <p class="hero-lead">
        Ihre zuverlässige Änderungsschneiderei in Düsseldorf-Oberkassel. Wir bieten professionelle Anpassungen, Reparaturen und Maßanfertigungen von Damen- und Herrenbekleidung. Schnelle und hochwertige handwerkliche Arbeit.
      </p>
    </div>
  </div>
</section>
