---
import { Image } from 'astro:assets';
import gallery01 from '../assets/images/gallery-01.jpg';
import gallery02 from '../assets/images/gallery-02.jpg';
import gallery03 from '../assets/images/gallery-03.jpg';
import gallery04 from '../assets/images/gallery-04.jpg';
import gallery05 from '../assets/images/gallery-05.jpg';
import gallery06 from '../assets/images/gallery-06.jpg';

const galleryItems = [
  { src: gallery01, alt: "Schneiderei Arbeitsplatz mit Nähmaschine" },
  { src: gallery02, alt: "Maßband und Schere auf Stoff" },
  { src: gallery03, alt: "Kundenberatung beim Abstecken eines Anzugs" },
  { src: gallery04, alt: "Detailaufnahme einer Nadel beim Nähen" },
  { src: gallery05, alt: "Verschiedene Garnrollen in vielen Farben" },
  { src: gallery06, alt: "Eingangsbereich der Änderungsschneiderei Altun" },
];
---

<!-- 
  TODO: Die aktuellen Bilder (gallery-01 bis gallery-06) sind nur Platzhalter. 
  Bitte durch 6 echte, unterschiedliche Fotos ersetzen, die zu den alt-Texten passen.
-->
<div class="gallery-band">
  <div class="gallery-band-inner">
    {
      galleryItems.map((item) => (
        <figure>
          <Image src={item.src} alt={item.alt} widths={[300, 600]} sizes="(max-width: 1024px) 33vw, 17vw" loading="lazy" />
        </figure>
      ))
    }
  </div>
</div>
