---
const steps = [
  { number: '01', title: 'Vorbeikommen', text: 'Bringen Sie Ihr Kleidungsstück einfach während unserer Öffnungszeiten vorbei.' },
  { number: '02', title: 'Abstecken & Beratung', text: 'Wir besprechen Ihre Wünsche und stecken das Kleidungsstück passgenau ab.' },
  { number: '03', title: 'Bearbeitung', text: 'Wir führen die Änderung oder Reparatur mit höchster Sorgfalt durch.' },
  { number: '04', title: 'Abholung', text: 'Ihr Kleidungsstück sitzt perfekt und ist bereit zur Abholung.' },
];
---

<section id="ablauf" class="dark">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">So einfach geht's</span>
      <h2>In 4 Schritten zum perfekten Sitz</h2>
    </div>

    <div class="steps">
      {
        steps.map((step) => (
          <div class="step">
            <div class="step-number">{step.number}</div>
            <h3>{step.title}</h3>
            <p set:html={step.text} />
          </div>
        ))
      }
    </div>
  </div>
</section>
