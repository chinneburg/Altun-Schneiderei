---
const steps = [
  { number: '01', title: 'Gespräch', text: 'Kostenloses Telefonat. Wir verstehen Ihr Geschäft und was Sie brauchen.' },
  { number: '02', title: 'Design', text: 'Sie erhalten einen ersten Entwurf, völlig kostenlos und unverbindlich.' },
  { number: '03', title: 'Feinschliff', text: 'Wir optimieren und passen an, bis alles zu 100% passt.' },
  { number: '04', title: 'Online', text: 'Ihre Seite geht live. Ab jetzt kümmern wir uns um alles.' },
];
---

<section id="ablauf" class="dark">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">So einfach geht's</span>
      <h2>In 4 Schritten zur neuen Webseite</h2>
    </div>

    <div class="steps">
      {
        steps.map((step) => (
          <div class="step">
            <div class="step-number">{step.number}</div>
            <h3>{step.title}</h3>
            <p set:html={step.text} />
          </div>
        ))
      }
    </div>
  </div>
</section>
