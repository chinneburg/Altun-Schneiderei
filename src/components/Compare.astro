---
import GalleryBand from './GalleryBand.astro';

const oldWay = [
  'Mehrere tausend Euro Einmalkosten, Ergebnis ungewiss.',
  'Handy-Ansicht funktioniert nicht richtig.',
  'Der IT-Mensch meldet sich tagelang nicht.',
  'Jede Änderung kostet extra und dauert ewig.',
];

const nyveoWay = [
  'Planbarer Monatspreis. Keine hohen Startkosten.',
  'Perfekt auf jedem Gerät. Moderne Technik.',
  'Ihr fester Ansprechpartner. Schnelle Reaktion.',
  'Änderungen im Abo enthalten. Einfach melden.',
];
---

<section class="section-images">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Warum nyveo</span>
      <h2>Ihre alte Webseite?<br />Jetzt wird's Zeit für Neues.</h2>
      <p class="section-lead">
        Die meisten lokalen Unternehmen kämpfen mit veralteten Websites. Wir ändern das.
      </p>
    </div>

    <div class="compare">
      <div class="compare-card">
        <h3><span class="check">✕</span> Der alte Weg</h3>
        <ul>
          {oldWay.map((item) => <li><span class="check">—</span><p>{item}</p></li>)}
        </ul>
      </div>
      <div class="compare-card positive">
        <h3><span class="check">✓</span> Der nyveo-Weg</h3>
        <ul>
          {nyveoWay.map((item) => <li><span class="check">✓</span><p>{item}</p></li>)}
        </ul>
      </div>
    </div>
  </div>

  <GalleryBand />
</section>
