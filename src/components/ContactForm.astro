---
import { site } from '../site';

// Web3Forms Endpoint (der einfachste Weg für statische Seiten)
const endpoint = 'https://api.web3forms.com/submit';
---

<form
  class="contact-form"
  id="kontaktformular"
  method="POST"
  action={endpoint}
  data-endpoint={endpoint}
  novalidate
>
  <!-- HIER DEN WEB3FORMS KEY EINTRAGEN (siehe Chat) -->
  <input type="hidden" name="access_key" value="4e41a4a7-59b3-4f5c-98b7-fc7d7ef4f05a" />
  
  <!-- Spam-Schutz (Honeypot) für Web3Forms -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

  <div class="field">
    <label for="cf-name">Name *</label>
    <!-- 'required' macht dies zum Pflichtfeld -->
    <input type="text" id="cf-name" name="name" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="cf-mail">E-Mail *</label>
    <!-- 'required' macht dies zum Pflichtfeld -->
    <input type="email" id="cf-mail" name="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="cf-msg">Nachricht</label>
    <!-- Placeholder statt Text, damit es dezent/weniger kontrastreich ist -->
    <textarea id="cf-msg" name="nachricht" rows="5" placeholder="Ich bin interessiert und freue mich, mit Ihnen in Kontakt zu treten."></textarea>
  </div>

  <div class="hp-field" aria-hidden="true" style="display:none;">
    <label for="cf-website">Bitte leer lassen</label>
    <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn primary">Anfrage senden</button>
  <p class="form-note" role="status" aria-live="polite"></p>

</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#kontaktformular');
  if (form) {
    const note = form.querySelector<HTMLParagraphElement>('.form-note')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const endpoint = form.dataset.endpoint;

    const say = (message: string, state: 'error' | 'success') => {
      note.textContent = message;
      note.classList.toggle('is-error', state === 'error');
      note.classList.toggle('is-success', state === 'success');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        say('Bitte füllen Sie alle Pflichtfelder aus.', 'error');
        form.reportValidity();
        return;
      }

      // Honeypot tripped — pretend nothing happened rather than tipping off a bot.
      if ((form.elements.namedItem('website') as HTMLInputElement)?.value) return;

      const accessKeyInput = form.elements.namedItem('access_key') as HTMLInputElement;
      if (!accessKeyInput || !accessKeyInput.value) {
        say('Das Formular ist noch nicht vollständig verknüpft (Key fehlt). Bitte schreiben Sie uns eine direkte E-Mail.', 'error');
        return;
      }

      // Wenn die Nachricht leer gelassen wurde, den Placeholder-Text als echten Wert setzen
      const msgInput = form.elements.namedItem('nachricht') as HTMLTextAreaElement;
      if (msgInput && msgInput.value.trim() === '') {
        msgInput.value = 'Ich bin interessiert und freue mich, mit Ihnen in Kontakt zu treten.';
      }

      submit.disabled = true;
      say('Wird gesendet …', 'success');

      try {
        const response = await fetch(endpoint!, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        say('Danke — wir melden uns in Kürze bei Ihnen.', 'success');
        form.reset();
      } catch {
        say('Senden fehlgeschlagen. Bitte schreiben Sie uns direkt eine E-Mail.', 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
