---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/storefront.jpg';
import detail1 from '../assets/images/interior_machine.jpg';
import detail2 from '../assets/images/threads.jpg';
---

<Base title="Änderungsschneiderei Altun – Düsseldorf-Oberkassel">
  <main class="tailor-layout">
    <header class="hero-section">
      <div class="hero-image">
        <Image src={heroImage} alt="Änderungsschneiderei Altun Außenansicht" widths={[640, 1024, 1920]} sizes="100vw" loading="eager" />
      </div>
      <div class="hero-content">
        <h1>Willkommen bei Altun</h1>
        <p>Ihre Änderungsschneiderei in Düsseldorf-Oberkassel.</p>
        <a href="#kontakt" class="btn">Besuchen Sie uns</a>
      </div>
    </header>

    <section id="leistungen" class="info-section">
      <div class="container">
        <div class="info-grid">
          <div class="info-text">
            <h2>Wir machen's passend...</h2>
            <p>
              Wir legen höchsten Wert auf handwerkliche Qualität, Präzision und Kundenzufriedenheit. Ob Sie ein Kleidungsstück anpassen, reparieren oder umarbeiten lassen möchten – wir stehen Ihnen mit unserer langjährigen Expertise zur Seite.
            </p>
            <ul class="services-list">
              <li><strong>Textilien</strong></li>
              <li><strong>Leder</strong></li>
              <li><strong>Pelze</strong></li>
              <li><strong>Dekorationen</strong></li>
            </ul>
          </div>
          <div class="info-images">
             <Image src={detail1} alt="Schneiderei Arbeitsplatz mit Nähmaschine" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 50vw" />
             <Image src={detail2} alt="Garnrollen in verschiedenen Farben" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 50vw" />
          </div>
        </div>
      </div>
    </section>

    <section id="kontakt" class="contact-section">
      <div class="container">
        <h2>Kommen Sie direkt vorbei</h2>
        <p class="contact-subtitle">Wir beraten Sie gerne unverbindlich vor Ort.</p>
        
        <div class="contact-card">
          <div class="contact-info">
            <h3>Öffnungszeiten</h3>
            <p>Montag – Freitag<br/><strong>09:00 – 18:30 Uhr</strong></p>
            <p>Samstag<br/><strong>09:00 – 14:00 Uhr</strong></p>
          </div>
          <div class="contact-info">
            <h3>Kontakt & Anfahrt</h3>
            <p>Änderungsschneiderei Altun</p>
            <p>Belsenstraße 25<br/>40545 Düsseldorf</p>
            <p class="phone">Telefon: <a href="tel:021146841229">0211 46841229</a></p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .tailor-layout {
    font-family: var(--font-sans);
    color: var(--text-main);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    height: 80vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 30, 0.75); /* Dark overlay */
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    max-width: 800px;
    padding: 2rem;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #ffffff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-content p {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    opacity: 0.95;
    margin-bottom: 2rem;
    color: #ffffff;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
  }

  .btn {
    display: inline-block;
    background: var(--accent); /* Red accent */
    color: #fff;
    padding: 1rem 2.5rem;
    text-decoration: none;
    font-weight: 500;
    border-radius: 4px;
    transition: background 0.3s;
  }

  .btn:hover {
    filter: brightness(0.9);
  }

  /* Info Section */
  .info-section {
    padding: 6rem 0;
    background: #f9f8f6;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .info-text h2 {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    color: #2c3e50;
  }

  .info-text p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    color: #555;
  }

  .services-list {
    list-style: none;
    padding: 0;
  }

  .services-list li {
    position: relative;
    padding-left: 1.8rem;
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
    color: #444;
  }

  .services-list li::before {
    content: '✂';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .info-images {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-images img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  /* Contact Section */
  .contact-section {
    padding: 6rem 0;
    background: #fff;
    text-align: center;
  }

  .contact-section h2 {
    font-size: 2.5rem;
    color: #2c3e50;
    margin-bottom: 0.5rem;
  }
  
  .contact-subtitle {
    color: #666;
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }

  .contact-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    background: #f9f8f6;
    padding: 3rem;
    border-radius: 8px;
    max-width: 800px;
    margin: 0 auto;
    text-align: left;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }

  @media (min-width: 600px) {
    .contact-card {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-info h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: var(--accent);
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 0.5rem;
  }

  .contact-info p {
    margin-bottom: 0.8rem;
    line-height: 1.5;
    color: #444;
  }
  
  .phone a {
    font-size: 1.2rem;
    font-weight: bold;
    color: #2c3e50;
    text-decoration: none;
  }
  
  .phone a:hover {
    color: var(--accent);
  }
</style>
