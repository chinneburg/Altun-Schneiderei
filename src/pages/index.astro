---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/storefront.jpg';
import detail1 from '../assets/images/interior_machine.jpg';
import detail2 from '../assets/images/threads.jpg';
---

<Base title="Änderungsschneiderei Altun – Düsseldorf">
    <!-- Editorial Hero -->
    <section class="hero-editorial">
      <Image 
        src={heroImage} 
        alt="Änderungsschneiderei Altun Außenansicht" 
        class="hero-img"
        loading="eager"
      />
      <div class="hero-overlay">
        <h1 class="text-editorial-headline text-white">Präzision & Handwerk</h1>
        <p class="text-uppercase text-white">Düsseldorf Oberkassel</p>
      </div>
    </section>

    <!-- Intro Text -->
    <section class="section-padding intro-section">
      <div class="intro-content">
        <p class="text-editorial-body">
          Willkommen in der Änderungsschneiderei Altun. Wir sind ein lokales Handwerksunternehmen, das sich der perfekten Passform verschrieben hat. Mit Sorgfalt, Erfahrung und Leidenschaft widmen wir uns jedem Kleidungsstück.
        </p>
      </div>
    </section>

    <!-- Services Grid (PNS Style Grid) -->
    <section id="leistungen" class="services-wrapper">
      <div class="grid-lines services-grid">
        
        <div class="service-card">
          <div class="service-image-wrapper">
            <Image src={detail1} alt="Schneiderei Arbeitsplatz" class="service-img" />
          </div>
          <div class="service-info">
            <h2 class="text-uppercase">Maßgeschneiderte Qualität</h2>
            <p class="text-editorial-body">
              Von der einfachen Hosenkürzung bis zur komplexen Sakkoanpassung – wir garantieren höchste handwerkliche Qualität und eine Passform, die sich sehen lassen kann.
            </p>
          </div>
        </div>

        <div class="service-card">
          <div class="service-image-wrapper">
            <Image src={detail2} alt="Garnrollen" class="service-img" />
          </div>
          <div class="service-info">
            <h2 class="text-uppercase">Unsere Leistungen</h2>
            <ul class="service-list text-editorial-body">
              <li>Anpassung von Textilien</li>
              <li>Leder- & Pelzbearbeitung</li>
              <li>Reparaturen (inkl. Schuhe)</li>
              <li>Dekorationen</li>
              <li>Schnelle Eilaufträge</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- Contact Info -->
    <section id="kontakt" class="section-padding contact-editorial">
      <div class="contact-grid">
        <div class="contact-block">
          <h3 class="text-uppercase mb-1">Besuchen Sie uns</h3>
          <p class="text-editorial-body">
            Änderungsschneiderei Altun<br />
            Belsenstraße 25<br />
            40545 Düsseldorf
          </p>
        </div>
        
        <div class="contact-block">
          <h3 class="text-uppercase mb-1">Kontakt</h3>
          <p class="text-editorial-body">
            Telefon: <a href="tel:021146841229" class="hover-underline">0211 46841229</a>
          </p>
        </div>

        <div class="contact-block">
          <h3 class="text-uppercase mb-1">Öffnungszeiten</h3>
          <p class="text-editorial-body">
            Mo – Fr: 09:00 – 18:30<br />
            Sa: 09:00 – 14:00<br />
            So: Geschlossen
          </p>
        </div>
      </div>
    </section>
</Base>

<style>
  /* Hero */
  .hero-editorial {
    position: relative;
    height: 80vh;
    min-height: 600px;
    width: 100%;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    text-align: center;
    padding: 2rem;
  }

  .text-white {
    color: #ffffff;
  }

  .hero-overlay h1 {
    margin-bottom: 1rem;
  }

  /* Intro */
  .intro-section {
    display: flex;
    justify-content: center;
    background-color: var(--color-white);
  }

  .intro-content {
    max-width: 800px;
    text-align: center;
  }

  /* Services Grid */
  .services-wrapper {
    background-color: var(--color-white);
    padding-bottom: 4rem;
  }

  .services-grid {
    grid-template-columns: 1fr;
    max-width: 1600px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-image-wrapper {
    position: relative;
    padding-top: 75%; /* 4:3 aspect ratio */
    overflow: hidden;
  }

  .service-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-info {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
  }

  .service-info h2 {
    margin-bottom: 1.5rem;
    color: var(--color-black);
  }

  .service-list {
    list-style: none;
    padding: 0;
  }

  .service-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  
  .service-list li:last-child {
    border-bottom: none;
  }

  /* Contact */
  .contact-editorial {
    background-color: var(--color-gray);
    border-top: 1px solid var(--color-border);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .mb-1 {
    margin-bottom: 1rem;
    display: block;
    color: var(--color-black);
  }

  .hover-underline:hover {
    text-decoration: underline;
  }
</style>
