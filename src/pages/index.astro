---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/storefront.jpg';
import detail1 from '../assets/images/interior_machine.jpg';
import detail2 from '../assets/images/threads.jpg';

const addressText = `${site.legalName}, ${site.address.street}, ${site.address.postalCode} ${site.address.city}`;
const mapsHref = site.mapsUrl;
---

<Base title="Änderungsschneiderei Altun – Düsseldorf-Oberkassel">
  <main class="tailor-layout">
    <section id="kontakt" class="hero-section">
      <div class="hero-image">
        <Image src={heroImage} alt="Änderungsschneiderei Altun Außenansicht" widths={[640, 1024, 1920]} sizes="100vw" loading="eager" />
      </div>
      <div class="hero-content">
        <h1>Altun</h1>
        <p>Ihre Änderungsschneiderei<br class="mobile-break" /> in Düsseldorf-Oberkassel</p>
        <div class="hero-info">
          <div class="hero-info-block">
            <h2>Öffnungszeiten</h2>
            <p>Mo – Fr &nbsp;<strong>09:00 – 18:30 Uhr</strong></p>
            <p>Sa &nbsp;<strong>09:00 – 14:00 Uhr</strong></p>
            <p class="hours-note">Feiertage: siehe <a href={mapsHref} target="_blank" rel="noopener">Google</a></p>
          </div>
          <div class="hero-info-block">
            <h2>Adresse</h2>
            <a class="address-link" href={mapsHref} target="_blank" rel="noopener" aria-label={`Adresse in Google Maps öffnen: ${addressText}`}>
              <p><strong>{site.address.street}</strong></p>
              <p>{site.address.postalCode} {site.address.city}</p>
            </a>
          </div>
        </div>
        <div class="hero-info hero-phone">
          <div class="hero-info-block">
            <h2>Telefon</h2>
            <p><a href={site.phoneHref}>{site.phone}</a></p>
          </div>
        </div>
      </div>
    </section>

    <section id="leistungen" class="info-section">
      <div class="container">
        <div class="info-images">
          <Image src={detail1} alt="Schneiderei Arbeitsplatz mit Nähmaschine" widths={[400, 800]} sizes="(max-width: 1200px) 50vw, 600px" />
          <Image src={detail2} alt="Garnrollen in verschiedenen Farben" widths={[400, 800]} sizes="(max-width: 1200px) 50vw, 600px" />
        </div>
        <div class="info-grid">
          <div class="info-text">
            <h2>Wir machen's passend...</h2>
            <p>
              Wir legen höchsten Wert auf handwerkliche Qualität, Präzision und Kundenzufriedenheit. Ob Sie ein Kleidungsstück anpassen, reparieren oder umarbeiten lassen möchten – wir stehen Ihnen mit unserer langjährigen Expertise zur Seite.
            </p>
          </div>
          <ul class="services-list" aria-label="Leistungen">
            <li>Textilien</li>
            <li>Leder</li>
            <li>Pelze</li>
            <li>Dekorationen</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="kundenstimmen" class="feedback-section">
      <div class="container">
        <h2>Was Kunden an uns schätzen</h2>
        <div class="feedback-grid">
          <article class="feedback-card">
            <h3>Präzise Handarbeit</h3>
            <p>Saubere Nähte und perfekte Passform – beim Kürzen von Hosen genauso wie bei Sakko und Hemd.</p>
          </article>
          <article class="feedback-card">
            <h3>Schnell und flexibel</h3>
            <p>Auch kurzfristige Aufträge sind möglich, oft schon innerhalb eines Tages, zum Beispiel für wichtige Anlässe.</p>
          </article>
          <article class="feedback-card">
            <h3>Persönliche Beratung</h3>
            <p>Wir setzen Ihre Wünsche genau um und machen Vorschläge, die den Tragekomfort verbessern.</p>
          </article>
          <article class="feedback-card">
            <h3>Faire Preise</h3>
            <p>Hochwertige Änderungen ohne überhöhte Kosten – Ergebnisse, die lange halten.</p>
          </article>
        </div>
        <p class="feedback-examples">
          Zum Beispiel: Hosen und Ärmel kürzen · Jacken und Sakkos anpassen · Knöpfe annähen · Schuhe und Sneakers reparieren
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .tailor-layout {
    font-family: var(--font-sans);
    color: var(--text-main);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Section */
  .hero-section {
    position: relative;
    isolation: isolate;
    min-height: clamp(560px, 72vh, 760px);
    padding: 3rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Light tint, a little darker at the top and bottom edges. */
    background: linear-gradient(
      180deg,
      rgba(25, 12, 18, 0.55) 0%,
      rgba(25, 12, 18, 0.35) 45%,
      rgba(25, 12, 18, 0.5) 100%
    );
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    width: 100%;
    max-width: 800px;
  }

  .hero-content h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 600;
    line-height: 1;
    margin-bottom: 1rem;
    color: #ffffff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .hero-content p {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    margin-bottom: 2rem;
    color: #ffffff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 600px) {
    .mobile-break {
      display: none;
    }
  }

  .hero-info {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 560px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
    background: rgba(20, 10, 15, 0.35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
  }

  @media (min-width: 600px) {
    .hero-info {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-info-block h2 {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.6rem;
  }

  .hero-content .hero-info-block p {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
    text-shadow: none;
  }

  .hero-content .hero-info-block p.hours-note {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .hours-note a {
    color: #ffffff;
    text-decoration: underline;
  }

  .address-link {
    display: block;
    color: #ffffff;
    text-decoration: none;
  }

  .address-link:hover p {
    text-decoration: underline;
  }

  .hero-info.hero-phone {
    grid-template-columns: 1fr;
    margin-top: 1rem;
    padding: 0.75rem 2rem;
  }

  .hero-phone .hero-info-block {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 1rem;
  }

  .hero-phone .hero-info-block h2,
  .hero-content .hero-phone .hero-info-block p {
    margin-bottom: 0;
  }

  .hero-phone a {
    font-size: 1.3rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
  }

  .hero-phone a:hover {
    text-decoration: underline;
  }

  /* Info Section */
  .info-section {
    padding: 2.5rem 0 3.5rem;
    background: var(--bg-alt);
  }

  .info-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .info-images img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 14px;
  }

  .info-grid {
    display: grid;
    gap: 2rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .info-text {
    text-align: center;
  }

  .info-text h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .info-text p {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #555;
  }

  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .services-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Feedback Section */
  .feedback-section {
    padding: 3rem 0 3.5rem;
    background: #fff;
    text-align: center;
  }

  .feedback-section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin-bottom: 2rem;
  }

  .feedback-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    text-align: left;
  }

  .feedback-card {
    padding: 1.5rem;
    background: var(--bg-alt);
    border-radius: 14px;
  }

  .feedback-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  .feedback-card p {
    color: #555;
    line-height: 1.6;
  }

  .feedback-examples {
    margin-top: 2rem;
    color: #666;
    line-height: 1.7;
  }

  .services-list li {
    padding: 0.9rem 0.5rem;
    text-align: center;
    border: 1px solid rgba(110, 60, 77, 0.35);
    border-radius: 12px;
    background: #fff;
    color: var(--accent);
    font-weight: 500;
  }
</style>
